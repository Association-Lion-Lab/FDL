# Copier ce fichier en .env puis remplacer les valeurs.
# Domaine public (DNS vers ce serveur) ; Caddy obtient le certificat HTTPS tout seul.
FDL_DOMAIN=fdl.example.org
COMPOSE_PROFILES=https
# Générer par exemple avec : openssl rand -hex 24
POSTGRES_PASSWORD=changer-moi
PGHOST=db
PGDATABASE=fdl
PGUSER=fdl
# Même valeur que POSTGRES_PASSWORD
PGPASSWORD=changer-moi
FDL_IMAGE=codeberg.org/lion_lab/fdl:latest
